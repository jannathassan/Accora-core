# Accora Core Backend Configuration

PROJECT_NAME="Accora Core"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Security & Tokens
# Generate a secure 32+ character key for production: openssl rand -hex 32
SECRET_KEY="accora-core-insecure-dev-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (Default: local SQLite database with WAL mode)
# For production PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/accora_core
DATABASE_URL="sqlite:///./accora_core.db"

# CORS Origins (Comma-separated list of allowed origins)
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Optional External AI Provider (Leave empty for built-in rules-based Financial Copilot)
# No API key required for standard operation!
AI_PROVIDER_API_KEY=""
AI_PROVIDER="none"
